# Copia este archivo a .env y ajusta. NUNCA subas .env al repositorio.

# --- LLM: ollama | unab | mock -------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b            # debe soportar tool calling

# --- Embeddings: ollama | mock --------------------------------------------------
EMBEDDINGS_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text-v2-moe

# --- Ollama ---------------------------------------------------------------------
# Local (sin Docker):            http://localhost:11434
# Docker con Ollama en tu Mac:   http://host.docker.internal:11434   (valor por defecto en compose)
# Docker con el servicio ollama: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Proveedor externo (solo si LLM_PROVIDER=unab) -------------------------------
UNAB_BASE_URL=https://quotas.devhub.cl/api/v1
UNAB_API_KEY=

# --- Buk (Configuración -> Acceso API en Buk) -----------------------------------
# Sin token, el conector responde una instancia de demostración (data/buk_demo/).
BUK_BASE_URL=https://demo.buk.cl/api/v1/chile
BUK_TOKEN=

# --- Analistas RR.HH. (centro React :8503 y Streamlit :8502) ---------------------
# Semilla al arrancar si la tabla está vacía.
ANALISTA_EMAIL=analista@clinica.local
ANALISTA_PASSWORD=analista123
# AUTH_SECRET=cambia-esto-en-produccion

# --- Opcionales ------------------------------------------------------------------
# CHROMA_DIR=./chroma_db
# RETRIEVER_K=4
# AGENT_MAX_STEPS=8
